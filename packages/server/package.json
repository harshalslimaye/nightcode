{
    "name": "@nightcode/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.39",
        "@ai-sdk/openai": "^4.0.42",
        "@hono/zod-validator": "^0.9.0",
        "@nightcode/database": "workspace:*",
        "@nightcode/shared": "workspace:*",
        "@types/node": "^26.2.0",
        "ai": "^7.0.66",
        "dotenv": "^17.4.2",
        "hono": "^4.13.2",
        "zod": "^4.4.3"
    }
}